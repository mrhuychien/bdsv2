# =============================================================================
#                    BATDONGSAN.DIGITAL - Environment Variables
# =============================================================================

# App URL (for OAuth redirects)
NEXT_PUBLIC_APP_URL=https://batdongsan.digital

# -----------------------------------------------------------------------------
# Supabase Configuration
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://ikkmumdaqbopacoxklzp.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Service role key (for server-side operations - KEEP SECRET!)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# =============================================================================
#                    POSTIZ INTEGRATION (Recommended)
# =============================================================================
# Postiz is an open-source social media scheduler that handles OAuth
# for all major platforms. Use this instead of individual OAuth setups.
#
# Options:
# 1. Use Postiz Cloud: https://postiz.com (get API key from dashboard)
# 2. Self-host: https://github.com/gitroomhq/postiz-app
# -----------------------------------------------------------------------------

# Postiz API Key (from Postiz dashboard or self-hosted instance)
POSTIZ_API_KEY=your_postiz_api_key

# Postiz API URL (only needed for self-hosted, leave empty for cloud)
# POSTIZ_API_URL=https://your-postiz-instance.com/api

# Postiz App URL (for OAuth redirects)
# POSTIZ_APP_URL=https://app.postiz.com

# Supported platforms via Postiz:
# - Facebook, Instagram, TikTok, YouTube
# - LinkedIn, X (Twitter), Threads
# - Pinterest, Reddit, Mastodon, Bluesky
# - Slack, Discord

# =============================================================================
#                    DIRECT OAUTH (Alternative - More Setup Required)
# =============================================================================
# Use these if you prefer direct OAuth instead of Postiz.
# Each platform requires separate app registration and approval.
# -----------------------------------------------------------------------------

# Facebook OAuth
# Get from: https://developers.facebook.com/apps/
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret

# Zalo OA OAuth (Vietnam only - not supported by Postiz)
# Get from: https://developers.zalo.me/
ZALO_APP_ID=your_zalo_app_id
ZALO_APP_SECRET=your_zalo_app_secret

# TikTok OAuth
# Get from: https://developers.tiktok.com/
TIKTOK_CLIENT_KEY=your_tiktok_client_key
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret

# -----------------------------------------------------------------------------
# Cron Job Security
# -----------------------------------------------------------------------------
# Secret for authenticating cron job requests
# Generate with: openssl rand -hex 32
CRON_SECRET=your_cron_secret_here
